---
import Base from "../../layouts/Base.astro";
---

<Base title="Propostas" chrome={false}>
  <section class="section">
    <div class="container max-w-3xl">
      <span class="eyebrow">Zyra · Propostas</span>
      <h1 class="title-h1 mt-5">Modelos de proposta</h1>
      <p class="lead mt-5">Três situações comerciais, um mesmo padrão visual. A estrutura é padrão; o conteúdo é específico por cliente.</p>

      <div class="mt-12 grid gap-5">
        <a href="/proposta/servico/" class="card card-lift flex items-start justify-between gap-4 p-7">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Serviço</p>
            <h2 class="mt-2 text-xl font-semibold text-ink">Proposta de Serviço</h2>
            <p class="mt-2 text-sm text-muted">Para quem quer contratar a Zyra. CTA: Aprovar e começar.</p>
          </div>
          <span class="text-2xl text-faint">→</span>
        </a>

        <a href="/proposta/parceria/" class="card card-lift flex items-start justify-between gap-4 p-7">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Parceria</p>
            <h2 class="mt-2 text-xl font-semibold text-ink">Programa de Parceiros</h2>
            <p class="mt-2 text-sm text-muted">Para quem quer apenas indicar empresas. CTA: Quero ser parceiro.</p>
          </div>
          <span class="text-2xl text-faint">→</span>
        </a>

        <a href="/proposta/servico-parceria/" class="card card-lift flex items-start justify-between gap-4 p-7">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Serviço + Parceria</p>
            <h2 class="mt-2 text-xl font-semibold text-ink">Proposta de Serviço + Parceria</h2>
            <p class="mt-2 text-sm text-muted">Para quem quer contratar e também participar do programa. CTA: Aprovar e começar.</p>
          </div>
          <span class="text-2xl text-faint">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>
