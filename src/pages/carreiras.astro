---
import Base from "../layouts/Base.astro";
import { wa } from "../data/site";

const benefits = [
  { title: "Treinamento", text: "Todas as pessoas do time passam por um processo de treinamento e integração." },
  { title: "Processo de trabalho estruturado", text: "Acesso a processos, ferramentas, materiais, orientações e padrões de execução." },
  { title: "Metas e acompanhamento", text: "Clareza sobre responsabilidades, objetivos e indicadores, com acompanhamento próximo." },
  { title: "Plano de crescimento claro", text: "Você sabe onde pode chegar. Construímos um caminho de evolução." },
  { title: "Suporte para evoluir", text: "Você não entra apenas para ocupar uma vaga: entra para crescer com a gente." },
  { title: "100% Home Office", text: "Trabalhe de qualquer lugar do Brasil, com processos e acompanhamento." },
];
---

<Base title="Carreiras" description="Trabalhe na Zyra. Vagas 100% remotas para profissionais de crescimento, marketing, tráfego, vendas e tecnologia.">
  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-3xl text-center">
        <span class="eyebrow">Carreiras</span>
        <h1 class="title-h1 mt-6">Liberdade para trabalhar de onde você estiver.</h1>
        <p class="lead mx-auto mt-6">
          Todas as nossas oportunidades são 100% remotas, para você trabalhar de
          qualquer lugar do Brasil.
        </p>
        <a href={wa("Olá, quero enviar meu currículo para a Zyra.")} target="_blank" rel="noopener" class="btn btn-primary mt-8">Enviar meu currículo</a>
      </div>

      <div class="mx-auto mt-16 grid max-w-5xl gap-6 sm:grid-cols-3">
        {[
          ["Modelo de contratação", "Prestação de serviços (PJ), para profissionais que atuam com autonomia."],
          ["Remuneração", "A combinar, definida conforme a vaga, a experiência e o nível de atuação."],
          ["Carga horária", "A combinar, conforme a função e as entregas esperadas."],
        ].map(([title, text]) => (
          <div class="card p-7">
            <h2 class="text-base font-semibold text-ink">{title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-muted">{text}</p>
          </div>
        ))}
      </div>

      <div class="mx-auto mt-20 max-w-5xl">
        <h2 class="title-h3 text-center text-ink">O que oferecemos em todas as vagas</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {benefits.map((b) => (
            <div class="card p-7">
              <h3 class="text-base font-semibold text-ink">{b.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{b.text}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mx-auto mt-20 max-w-2xl overflow-hidden rounded-[var(--radius-3xl)] bg-ink p-10 text-center text-white sm:p-14">
        <h2 class="title-h3 text-white">Não encontrou uma vaga para você?</h2>
        <p class="mt-4 text-sm leading-relaxed text-brand-100/75">
          Faça parte do crescimento. Envie seu currículo e conte como você pode
          ajudar a Zyra a entregar resultado para mais empresas.
        </p>
        <a href={wa("Olá, quero fazer parte do time da Zyra. Segue meu currículo.")} target="_blank" rel="noopener" class="btn btn-primary mt-8">Falar com a Zyra</a>
      </div>
    </div>
  </section>
</Base>
