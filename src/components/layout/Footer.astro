---
import { site, wa } from "../../data/site";
const year = new Date().getFullYear();
---

<footer class="bg-ink pt-20 pb-32 text-brand-100/70 sm:pb-16">
  <div class="container">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-2">
          <img src="/img/logo-zyra.webp" alt="" width="340" height="133" class="h-6 w-auto" />
          <span class="text-[1.0625rem] font-semibold tracking-tight text-white">Zyra</span>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed">
          {site.tagline} Estratégia e execução por nossa conta. Você só aprova e vê
          os resultados.
        </p>
      </div>

      <nav class="lg:col-span-4" aria-label="Rodapé">
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-white">Navegação</h2>
        <ul class="mt-5 grid grid-cols-2 gap-y-3 text-sm">
          <li><a href="/#como-funciona" class="transition hover:text-white">Como funciona</a></li>
          <li><a href="/#areas" class="transition hover:text-white">O que cuidamos</a></li>
          <li><a href="/#planos" class="transition hover:text-white">Planos</a></li>
          <li><a href="/#parceiro" class="transition hover:text-white">Seja parceiro</a></li>
          <li><a href="/#duvidas" class="transition hover:text-white">Dúvidas</a></li>
          <li><a href="/carreiras/" class="transition hover:text-white">Trabalhe conosco</a></li>
          <li><a href="/privacidade/" class="transition hover:text-white">Privacidade</a></li>
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-white">Contato</h2>
        <a
          href={wa()}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-300 transition hover:text-brand-200"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.8 1.9c.1.2.1.4 0 .6l-.3.5-.4.4c-.1.1-.3.3-.1.5.2.3.8 1.3 1.7 2.1 1.2 1 2.2 1.4 2.5 1.5.2.1.4.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.2.1.7-.1 1.4z" />
          </svg>
          {site.whatsappLabel}
        </a>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-xs sm:flex-row">
      <p>© {year} Zyra. Todos os direitos reservados.</p>
      <a href="/privacidade/" class="transition hover:text-white">Política de Privacidade</a>
    </div>
  </div>
</footer>
