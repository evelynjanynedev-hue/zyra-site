---
import { nav, wa } from "../../data/site";
---

<header class="sticky top-0 z-50 border-b border-line bg-surface/80 backdrop-blur-xl">
  <div class="container flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2" aria-label="Zyra, início">
      <img src="/img/logo-zyra.webp" alt="" width="340" height="133" class="h-6 w-auto" />
      <span class="text-[1.0625rem] font-semibold tracking-tight text-ink">Zyra</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-[0.95rem] font-medium text-muted transition-colors hover:text-ink"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={wa("Olá, quero falar com a Zyra sobre o crescimento da minha empresa.")}
        target="_blank"
        rel="noopener"
        class="btn btn-primary hidden md:inline-flex"
      >
        Falar com a Zyra
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-ink md:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-surface md:hidden">
    <nav class="container flex flex-col py-3" aria-label="Menu mobile">
      {nav.map((item) => (
        <a href={item.href} class="rounded-lg px-2 py-3 text-base font-medium text-ink hover:bg-surface-2">
          {item.label}
        </a>
      ))}
      <a
        href={wa("Olá, quero falar com a Zyra sobre o crescimento da minha empresa.")}
        target="_blank"
        rel="noopener"
        class="btn btn-primary mt-2"
      >
        Falar com a Zyra
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!open));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => menu.classList.add("hidden"))
  );
</script>
