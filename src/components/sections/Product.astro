---
import SectionHeader from "../ui/SectionHeader.astro";
import DashboardMock from "../DashboardMock.astro";
---

<section class="section">
  <div class="container">
    <SectionHeader
      eyebrow="Você acompanha o que importa"
      title="Tudo fica organizado."
      lead="Você não precisa perguntar o que aconteceu. A Zyra mantém a operação, os leads, as oportunidades e os próximos passos organizados, para você acompanhar o crescimento sem gerenciar o operacional."
    />

    <div class="relative mx-auto mt-16 max-w-4xl">
      <div class="pointer-events-none absolute inset-x-16 -top-10 -z-10 h-52 rounded-full bg-gradient-to-r from-brand-500/25 via-brand-400/20 to-brand-300/20 glow-lg"></div>
      <DashboardMock />
    </div>
  </div>
</section>
