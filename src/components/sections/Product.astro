---
import SectionHeader from "../ui/SectionHeader.astro";
const columns = [
  { stage: "Novos", count: 12, tone: "text-brand-600", bar: "bg-brand-500" },
  { stage: "Em negociação", count: 7, tone: "text-warning", bar: "bg-warning" },
  { stage: "Ganhos", count: 5, tone: "text-success", bar: "bg-success" },
];
---

<section class="section">
  <div class="container">
    <SectionHeader
      eyebrow="Você acompanha o que importa"
      title="Tudo fica organizado."
      lead="Você não precisa perguntar o que aconteceu. O Zyra360 mantém a operação, os leads, as oportunidades e os próximos passos organizados, para você acompanhar o crescimento sem gerenciar o operacional."
    />

    <div class="relative mt-16">
      <div class="pointer-events-none absolute inset-x-24 -top-10 -z-10 h-52 rounded-full bg-gradient-to-r from-brand-500/20 via-accent-500/20 to-cyan-400/20 glow"></div>
      <div class="relative overflow-hidden rounded-[var(--radius-3xl)] border border-line bg-surface shadow-[var(--shadow-xl)]">
        <span class="absolute right-5 top-5 z-10 rounded-full border border-line bg-surface/90 px-3 py-1 text-[11px] font-medium text-muted shadow-[var(--shadow-xs)] backdrop-blur">
          Painel ilustrativo
        </span>
        <div class="grid items-stretch lg:grid-cols-5">
          <div class="relative p-6 sm:p-8 lg:col-span-3">
            <img
              src="/img/analytics.jpg"
              alt="Painel de resultados da operação da Zyra"
              width="1200"
              height="800"
              loading="lazy"
              class="h-64 w-full rounded-2xl object-cover sm:h-[22rem]"
            />
            <div class="absolute bottom-11 left-11 rounded-2xl border border-line bg-surface/95 px-5 py-4 shadow-[var(--shadow-md)] backdrop-blur">
              <p class="text-[11px] font-medium text-faint">Resultado acompanhado</p>
              <p class="mt-1 text-2xl font-semibold text-ink">
                +18%<span class="ml-2 align-middle text-xs font-medium text-success">no período</span>
              </p>
            </div>
          </div>

          <div class="flex flex-col border-t border-line p-6 sm:p-8 lg:col-span-2 lg:border-l lg:border-t-0">
            <div class="space-y-4">
              {columns.map((c) => (
                <div class="rounded-2xl border border-line p-4">
                  <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-ink">{c.stage}</p>
                    <p class:list={["text-xl font-semibold", c.tone]}>{c.count}</p>
                  </div>
                  <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-surface-3">
                    <div class:list={["h-full rounded-full", c.bar]} style={`width:${(c.count / 12) * 100}%`}></div>
                  </div>
                </div>
              ))}
            </div>
            <ul class="mt-5 space-y-2.5">
              {["Contato novo aguardando retorno", "Proposta enviada para o cliente", "Follow-up agendado para amanhã"].map((t) => (
                <li class="flex items-center gap-3 text-sm text-ink">
                  <span class="h-2 w-2 shrink-0 rounded-full bg-brand-500"></span>{t}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
