---
import { plans, wa } from "../../data/site";
import SectionHeader from "../ui/SectionHeader.astro";
---

<section id="planos" class="section scroll-mt-20">
  <div class="container">
    <SectionHeader
      eyebrow="Planos"
      title="Comece pequeno. Veja acontecer."
      lead="Você não precisa montar uma equipe para começar a cuidar do crescimento. E sem fidelidade."
    />

    <div class="mt-16 grid items-stretch gap-6 lg:grid-cols-3">
      {plans.map((plan) => {
        const dark = plan.highlight;
        return (
          <article class:list={["relative flex flex-col overflow-hidden rounded-[var(--radius-2xl)] p-8", dark ? "bg-ink text-white shadow-[var(--shadow-xl)]" : "card"]}>
            {dark && <div class="pointer-events-none absolute inset-x-0 -top-20 h-40 bg-gradient-to-r from-brand-500/40 via-accent-500/40 to-cyan-400/30 glow"></div>}

            <div class="relative flex min-h-[3rem] items-center justify-between gap-3">
              <h3 class:list={["text-lg font-semibold", dark ? "text-white" : "text-ink"]}>{plan.name}</h3>
              {plan.badge && (
                <span class:list={["rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-wide", dark ? "bg-white/10 text-brand-200 ring-1 ring-white/15" : "bg-brand-50 text-brand-600 ring-1 ring-brand-100"]}>
                  {plan.badge}
                </span>
              )}
            </div>

            <p class:list={["relative mt-1.5 text-sm", dark ? "text-brand-100/70" : "text-muted"]}>{plan.audience}</p>

            <p class:list={["relative mt-7 text-[2.5rem] font-semibold leading-none tracking-tight", dark ? "text-white" : "text-ink"]}>
              R$ {plan.price}<span class:list={["text-base font-medium", dark ? "text-brand-100/60" : "text-muted"]}>/mês</span>
            </p>

            <div class:list={["relative mt-7 border-t pt-7", dark ? "border-white/10" : "border-line"]}>
              <p class:list={["text-xs font-semibold uppercase tracking-[0.18em]", dark ? "text-brand-300" : "text-muted"]}>A Zyra assume</p>
              <ul class:list={["mt-4 space-y-2.5 text-sm", dark ? "text-brand-100/90" : "text-ink"]}>
                {plan.includes.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class:list={[dark ? "text-brand-300" : "text-brand-500"]} aria-hidden="true">✓</span>{item}
                  </li>
                ))}
              </ul>
            </div>

            <div class="relative mt-auto pt-7">
              <p class:list={["text-sm", dark ? "text-brand-100/70" : "text-muted"]}>{plan.note}</p>
              <a href={wa(`Olá, quero o plano ${plan.name} da Zyra (R$ ${plan.price}/mês).`)} target="_blank" rel="noopener" class:list={["mt-5 w-full", dark ? "btn btn-primary" : "btn btn-secondary"]}>
                {plan.cta}
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <p class="mx-auto mt-10 max-w-3xl text-center text-sm leading-relaxed text-muted">
      A Zyra cuida do marketing, do tráfego e do acompanhamento dos leads. O
      fechamento da venda é feito pelo seu time comercial, e ajudamos a estruturar
      esse processo.
    </p>
    <p class="mt-4 text-center text-sm font-medium text-muted">
      Não sabe qual plano escolher? <a href={wa("Olá, quero ajuda para escolher o plano da Zyra.")} target="_blank" rel="noopener" class="font-semibold text-brand-500 underline decoration-brand-200 underline-offset-4 hover:text-brand-600">Fale com nosso time.</a>
    </p>
  </div>
</section>
