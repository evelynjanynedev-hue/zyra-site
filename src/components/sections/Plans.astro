---
import { plans, wa } from "../../data/site";
import SectionHeader from "../ui/SectionHeader.astro";
---

<section id="planos" class="section scroll-mt-20">
  <div class="container">
    <SectionHeader
      eyebrow="Planos"
      title="Comece pequeno. Veja acontecer."
      lead="Você não precisa montar uma equipe para começar a cuidar do crescimento. E sem fidelidade."
    />

    <div class="mt-16 grid items-stretch gap-6 lg:grid-cols-3">
      {plans.map((plan) => {
        const featured = plan.highlight;
        return (
          <article
            class:list={[
              "relative flex flex-col overflow-hidden rounded-[var(--radius-2xl)] p-8",
              featured
                ? "ring-gradient bg-gradient-to-b from-brand-50/80 to-surface shadow-[var(--shadow-md)]"
                : "card",
            ]}
          >
            <div class="relative flex min-h-[3rem] items-center justify-between gap-3">
              <h3 class="text-lg font-semibold text-ink">{plan.name}</h3>
              {plan.badge && (
                <span class="rounded-full bg-brand-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-brand-600 ring-1 ring-brand-100">
                  {plan.badge}
                </span>
              )}
              {featured && !plan.badge && (
                <span class="rounded-full bg-accent-600 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-white">
                  Recomendado
                </span>
              )}
            </div>

            <p class="relative mt-1.5 text-sm text-muted">{plan.audience}</p>

            <p class="relative mt-7 text-[2.5rem] font-semibold leading-none tracking-tight text-ink">
              R$ {plan.price}<span class="text-base font-medium text-muted">/mês</span>
            </p>

            <div class="relative mt-7 border-t border-line pt-7">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">A Zyra assume</p>
              <ul class="mt-4 space-y-2.5 text-sm text-ink">
                {plan.includes.map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="text-brand-500" aria-hidden="true">✓</span>{item}
                  </li>
                ))}
              </ul>
            </div>

            <div class="relative mt-auto pt-7">
              <p class="text-sm text-muted">{plan.note}</p>
              <a
                href={wa(`Olá, quero o plano ${plan.name} da Zyra (R$ ${plan.price}/mês).`)}
                target="_blank"
                rel="noopener"
                class:list={["mt-5 w-full", featured ? "btn btn-primary" : "btn btn-secondary"]}
              >
                {plan.cta}
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <p class="mx-auto mt-10 max-w-3xl text-center text-sm leading-relaxed text-muted">
      A Zyra cuida do marketing, do tráfego e do acompanhamento dos leads. O
      fechamento da venda é feito pelo seu time comercial, e ajudamos a estruturar
      esse processo.
    </p>
    <p class="mt-4 text-center text-sm font-medium text-muted">
      Não sabe qual plano escolher? <a href={wa("Olá, quero ajuda para escolher o plano da Zyra.")} target="_blank" rel="noopener" class="font-semibold text-brand-500 underline decoration-brand-200 underline-offset-4 hover:text-brand-600">Fale com nosso time.</a>
    </p>
  </div>
</section>
