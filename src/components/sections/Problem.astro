---
import SectionHeader from "../ui/SectionHeader.astro";

const items = ["Marketing", "Leads", "Atendimento", "Vendas", "CRM", "Ferramentas", "Estratégia"];
---

<section class="section">
  <div class="container">
    <SectionHeader
      eyebrow="Isso parece familiar?"
      title="O crescimento não deveria depender de você cuidar de tudo."
      lead="Marketing, leads, atendimento, vendas, ferramentas, estratégia. Quando cada parte fica separada, alguém precisa coordenar tudo, e normalmente esse alguém é você."
    />

    <div class="mx-auto mt-12 flex max-w-3xl flex-wrap justify-center gap-3">
      {items.map((i) => (
        <span class="rounded-full border border-line bg-surface px-5 py-2.5 text-sm font-medium text-muted shadow-[var(--shadow-xs)]">{i}</span>
      ))}
    </div>

    <div class="relative mx-auto mt-16 max-w-3xl overflow-hidden rounded-[var(--radius-3xl)] bg-ink px-8 py-14 text-center sm:px-12">
      <div class="pointer-events-none absolute inset-x-0 -top-24 h-48 bg-gradient-to-r from-brand-500/40 via-accent-500/40 to-cyan-400/30 glow"></div>
      <p class="relative text-xs font-semibold uppercase tracking-[0.18em] text-brand-300">É aí que a Zyra entra</p>
      <p class="relative mt-5 text-2xl font-semibold tracking-tight text-white sm:text-4xl">
        Você cuida do negócio.<br />A Zyra cuida do crescimento.
      </p>
    </div>
  </div>
</section>
