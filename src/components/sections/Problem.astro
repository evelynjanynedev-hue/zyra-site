---
import SectionHeader from "../ui/SectionHeader.astro";

const items = ["Marketing", "Leads", "Atendimento", "Vendas", "CRM", "Ferramentas", "Estratégia", "Otimização"];
---

<section class="section">
  <div class="container">
    <SectionHeader
      eyebrow="Isso parece familiar?"
      title="O crescimento não deveria depender de você cuidar de tudo."
      lead="Marketing, leads, atendimento, vendas, ferramentas, estratégia. Quando cada parte fica separada, alguém precisa coordenar tudo, e normalmente esse alguém é você."
    />

    <div class="mx-auto mt-12 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-4">
      {items.map((i) => (
        <span class="rounded-xl border border-line bg-surface px-4 py-3.5 text-center text-sm font-medium text-muted shadow-[var(--shadow-xs)]">{i}</span>
      ))}
    </div>

    <div class="grain relative mx-auto mt-16 max-w-3xl overflow-hidden rounded-[var(--radius-3xl)] bg-gradient-to-br from-brand-600 via-brand-500 to-accent-600 px-8 py-16 text-center shadow-[var(--shadow-glow)] sm:px-12">
      <p class="relative text-xs font-semibold uppercase tracking-[0.18em] text-white/80">É aí que a Zyra entra</p>
      <p class="relative mt-5 text-2xl font-semibold tracking-tight text-white sm:text-4xl">
        Você cuida do negócio.<br />A Zyra cuida do crescimento.
      </p>
    </div>
  </div>
</section>
