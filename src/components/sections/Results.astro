---
import SectionHeader from "../ui/SectionHeader.astro";
const transformations = [
  {
    before: "Negócios chegavam e se perdiam.",
    action: "Organizamos o atendimento e o processo comercial.",
    after: "Cada oportunidade passa a ter um próximo passo definido.",
  },
  {
    before: "Marketing e vendas em caminhos separados.",
    action: "Conectamos aquisição, atendimento e acompanhamento.",
    after: "Uma operação única, com o mesmo objetivo.",
  },
  {
    before: "Sem clareza do que está funcionando.",
    action: "Medimos o que acontece e ajustamos a cada ciclo.",
    after: "Você enxerga o resultado e o próximo passo.",
  },
];
---

<section class="section bg-surface-2/60">
  <div class="container">
    <SectionHeader
      eyebrow="O que muda"
      title="Da desorganização ao acompanhamento."
      lead="O que a Zyra organiza quando assume a operação de crescimento."
    />

    <div class="mt-16 grid items-stretch gap-6 lg:grid-cols-5">
      <div class="card flex flex-col overflow-hidden lg:col-span-2">
        <img
          src="/img/team-work.jpg"
          alt="Time acompanhando os resultados da operação"
          width="1200"
          height="900"
          loading="lazy"
          class="h-56 w-full object-cover"
        />
        <div class="flex flex-1 flex-col p-7">
          <p class="text-lg font-semibold text-ink">Acompanhamento próximo, decisões com clareza.</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Você sabe o que foi feito, o que funcionou e qual é o próximo passo, sem
            precisar caçar informação.
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-4 lg:col-span-3">
        {transformations.map((t) => (
          <div class="card flex flex-1 flex-col justify-center p-6 sm:p-7">
            <div class="grid gap-5 sm:grid-cols-3">
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-faint">Antes</p>
                <p class="mt-2 text-sm leading-relaxed text-ink">{t.before}</p>
              </div>
              <div class="sm:border-l sm:border-line sm:pl-5">
                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-600">O que a Zyra organiza</p>
                <p class="mt-2 text-sm leading-relaxed text-ink">{t.action}</p>
              </div>
              <div class="sm:border-l sm:border-line sm:pl-5">
                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-success">O que muda</p>
                <p class="mt-2 text-sm leading-relaxed text-ink">{t.after}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
