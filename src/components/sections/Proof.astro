---
const segments = [
  "Clínicas",
  "Consultórios",
  "Escritórios",
  "Comércio local",
  "Indústrias",
  "Serviços",
  "Prestadores",
  "Profissionais liberais",
];
---

<section class="border-y border-line bg-tint">
  <div class="container py-14">
    <div class="flex flex-col items-center gap-8 lg:flex-row lg:justify-between">
      <div class="flex items-center gap-5">
        <p class="text-5xl font-semibold tracking-tight text-ink">80+</p>
        <div class="text-left">
          <p class="text-sm font-semibold text-ink">empresas atendidas</p>
          <p class="mt-0.5 text-sm text-warning" aria-label="Avaliação cinco estrelas">★★★★★</p>
        </div>
      </div>
      <p class="max-w-md text-center text-sm leading-relaxed text-muted lg:text-left">
        Empresas de diferentes segmentos já confiaram à Zyra parte da sua operação
        de crescimento.
      </p>
    </div>

    <div class="mt-9 flex flex-wrap justify-center gap-2.5 lg:justify-start">
      {segments.map((s) => (
        <span class="rounded-full border border-line bg-surface px-4 py-1.5 text-sm text-muted">{s}</span>
      ))}
    </div>
  </div>
</section>
