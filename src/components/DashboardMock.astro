---
const kpis = [
  { label: "Novos contatos", value: "128", delta: "+12%", tone: "text-brand-600" },
  { label: "Em negociação", value: "34", delta: "+6%", tone: "text-warning" },
  { label: "Ganhos", value: "19", delta: "+9%", tone: "text-success" },
];

const pipeline = [
  { stage: "Novos", count: 12, pct: 100, color: "var(--color-brand-500)" },
  { stage: "Em negociação", count: 7, pct: 58, color: "var(--color-warning)" },
  { stage: "Ganhos", count: 5, pct: 42, color: "var(--color-success)" },
];

const navItems = ["Visão geral", "Operação", "Oportunidades", "Estratégia", "Resultados"];
---

<div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-[var(--shadow-xl)]">
  <!-- browser bar -->
  <div class="flex items-center gap-2 border-b border-line bg-surface-2/70 px-4 py-3">
    <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
    <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
    <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
    <span class="mx-auto hidden items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 text-[11px] text-faint sm:flex">
      <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
      app.zyra360.com.br
    </span>
  </div>

  <div class="grid grid-cols-12">
    <!-- sidebar -->
    <aside class="col-span-3 hidden flex-col border-r border-line bg-surface-2/50 p-4 sm:flex">
      <div class="flex items-center gap-2">
        <span class="grid h-7 w-7 place-items-center rounded-lg bg-brand-500 text-xs font-bold text-white">Z</span>
        <span class="text-sm font-semibold text-ink">Zyra</span>
      </div>
      <nav class="mt-6 space-y-1">
        {navItems.map((item, i) => (
          <div class:list={["flex items-center gap-2.5 rounded-lg px-3 py-2 text-[12px]", i === 0 ? "bg-surface text-ink shadow-[var(--shadow-xs)] font-semibold" : "text-faint"]}>
            <span class:list={["h-1.5 w-1.5 rounded-full", i === 0 ? "bg-brand-500" : "bg-line"]}></span>
            {item}
          </div>
        ))}
      </nav>
      <div class="mt-auto rounded-xl border border-line bg-surface p-3">
        <p class="text-[11px] font-semibold text-ink">Operação ativa</p>
        <p class="mt-1 text-[10px] text-faint">Sincronizado agora</p>
      </div>
    </aside>

    <!-- main -->
    <div class="col-span-12 p-4 sm:col-span-9 sm:p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-[11px] font-medium text-faint">Visão geral</p>
          <p class="text-[15px] font-semibold text-ink">Operação deste mês</p>
        </div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-success-soft px-2.5 py-1 text-[10px] font-semibold text-success">
          <span class="h-1.5 w-1.5 rounded-full bg-success"></span> Ao vivo
        </span>
      </div>

      <!-- KPIs -->
      <div class="mt-5 grid grid-cols-3 gap-3">
        {kpis.map((k) => (
          <div class="rounded-xl border border-line p-3.5">
            <p class="text-[10px] font-medium text-faint">{k.label}</p>
            <p class="mt-1.5 text-2xl font-semibold tracking-tight text-ink">{k.value}</p>
            <p class:list={["mt-1 text-[10px] font-semibold", k.tone]}>{k.delta}</p>
          </div>
        ))}
      </div>

      <!-- chart -->
      <div class="mt-4 rounded-xl border border-line p-4">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-medium text-faint">Resultado acompanhado</p>
          <span class="text-[10px] font-semibold text-success">+58% no período</span>
        </div>
        <div class="mt-3">
          <svg viewBox="0 0 560 140" class="h-28 w-full" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--color-brand-500)" stop-opacity="0.28"></stop>
                <stop offset="100%" stop-color="var(--color-brand-500)" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="M0,110 C60,96 90,70 140,78 C190,86 220,40 280,44 C340,48 360,72 420,52 C470,36 510,24 560,18 L560,140 L0,140 Z" fill="url(#area)"></path>
            <path d="M0,110 C60,96 90,70 140,78 C190,86 220,40 280,44 C340,48 360,72 420,52 C470,36 510,24 560,18" fill="none" stroke="var(--color-brand-500)" stroke-width="2.5" stroke-linecap="round"></path>
          </svg>
        </div>
        <div class="mt-1 flex justify-between text-[9px] text-faint">
          {["Jan","Fev","Mar","Abr","Mai","Jun","Jul","Ago","Set","Out","Nov","Dez"].map((m) => (
            <span>{m}</span>
          ))}
        </div>
      </div>

      <!-- pipeline -->
      <div class="mt-4 grid gap-2.5">
        {pipeline.map((p) => (
          <div class="rounded-xl border border-line p-3.5">
            <div class="flex items-center justify-between">
              <p class="text-[12px] font-medium text-ink">{p.stage}</p>
              <p class="text-[13px] font-semibold text-ink">{p.count}</p>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-surface-3">
              <div class="h-full rounded-full" style={`width:${p.pct}%;background:${p.color}`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
