---
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  align?: "split" | "center" | "left";
  invert?: boolean;
}
const { eyebrow, title, lead, align = "split", invert = false } = Astro.props;
const headingClass = ["title-h2", eyebrow ? "mt-5" : "", invert ? "text-white" : "text-ink"];
---

{align === "split" ? (
  <div class="grid gap-x-16 gap-y-6 md:grid-cols-2 md:items-end">
    <div>
      {eyebrow && <span class={invert ? "eyebrow eyebrow--invert" : "eyebrow"}>{eyebrow}</span>}
      <h2 class:list={headingClass}>{title ?? <slot />}</h2>
    </div>
    {lead && <p class:list={["lead md:pb-2", invert ? "!text-brand-100/75" : ""]}>{lead}</p>}
  </div>
) : align === "center" ? (
  <div class="mx-auto max-w-3xl text-center">
    {eyebrow && <span class={invert ? "eyebrow eyebrow--invert" : "eyebrow"}>{eyebrow}</span>}
    <h2 class:list={headingClass}>{title ?? <slot />}</h2>
    {lead && <p class:list={["lead mx-auto mt-5 max-w-2xl", invert ? "!text-brand-100/75" : ""]}>{lead}</p>}
  </div>
) : (
  <div class="max-w-2xl">
    {eyebrow && <span class={invert ? "eyebrow eyebrow--invert" : "eyebrow"}>{eyebrow}</span>}
    <h2 class:list={headingClass}>{title ?? <slot />}</h2>
    {lead && <p class:list={["lead mt-5", invert ? "!text-brand-100/75" : ""]}>{lead}</p>}
  </div>
)}
